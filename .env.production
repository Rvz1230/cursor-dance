# CursorDance 生产构建 — AI 端点配置
#
# 部署后端到阿里云 FC 后，将下方 URL 替换为你的 FC 域名：
#   s deploy 完成后会输出类似 https://cursor-dance-api-xxx.cn-hangzhou.fcapp.run
#   完整端点 = {域名}/api/ai/scheme-proposals
#
# 流式端点和 Agent 端点由 client.js 自动计算（/stream 和 /agent/run），无需单独配置。

VITE_CURSORDANCE_AI_API_ENDPOINT=https://cursor-ance-api-hypuuhmhhe.cn-hangzhou.fcapp.run/api/ai/scheme-proposals
VITE_CURSORDANCE_AI_API_STREAM_ENDPOINT=
VITE_CURSORDANCE_AI_AGENT_ENDPOINT=

# 访问鉴权 Token — 需与 FC 环境变量 CURSORDANCE_AI_API_ACCESS_TOKEN 一致
VITE_CURSORDANCE_AI_API_ACCESS_TOKEN=cursor-dance-rvz-2026

# 请求超时（毫秒）
VITE_CURSORDANCE_AI_TIMEOUT_MS=25000
