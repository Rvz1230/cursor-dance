# CursorDance 生产构建 — AI 端点配置
#
# 后端部署地址示例：{域名或IP}/api/ai/scheme-proposals
#
# 流式端点和 Agent 端点由 client.js 自动计算（/stream 和 /agent/run），无需单独配置。

VITE_CURSORDANCE_AI_API_ENDPOINT=https://your-domain.com/api/ai/scheme-proposals
VITE_CURSORDANCE_AI_API_STREAM_ENDPOINT=
VITE_CURSORDANCE_AI_AGENT_ENDPOINT=

# 访问鉴权 Token — 需与后端环境变量 CURSORDANCE_AI_API_ACCESS_TOKEN 一致
VITE_CURSORDANCE_AI_API_ACCESS_TOKEN=your-token-here

# 请求超时（毫秒）
VITE_CURSORDANCE_AI_TIMEOUT_MS=25000
