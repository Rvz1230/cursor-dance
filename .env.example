# CursorDance AI API local development

# OpenAI Responses API mode
OPENAI_API_KEY=
CURSORDANCE_AI_API_MODE=responses
CURSORDANCE_AI_MODEL=gpt-4.1-mini

# OpenAI-compatible Chat Completions mode, such as DeepSeek
# CURSORDANCE_AI_API_KEY=
# CURSORDANCE_AI_API_BASE_URL=https://api.deepseek.com
# CURSORDANCE_AI_API_MODE=chat_completions
# CURSORDANCE_AI_MODEL=deepseek-chat

# Local API server
CURSORDANCE_AI_API_HOST=127.0.0.1
CURSORDANCE_AI_API_PORT=8787
