# CursorDance AI API local development

# OpenAI Responses API mode
OPENAI_API_KEY=
CURSORDANCE_AI_API_MODE=responses
CURSORDANCE_AI_MODEL=gpt-4.1-mini

# OpenAI-compatible Chat Completions mode, such as DeepSeek
# CURSORDANCE_AI_API_KEY=
# CURSORDANCE_AI_API_BASE_URL=https://api.deepseek.com
# CURSORDANCE_AI_API_MODE=chat_completions
# CURSORDANCE_AI_MODEL=deepseek-chat

# Local API server
CURSORDANCE_AI_API_HOST=127.0.0.1
CURSORDANCE_AI_API_PORT=8787

# Frontend AI endpoint. For extension production builds, point this to your deployed backend.
VITE_CURSORDANCE_AI_API_ENDPOINT=/api/ai/scheme-proposals

# Optional endpoint override for `npm run ai:check`.
CURSORDANCE_AI_API_CHECK_ENDPOINT=http://127.0.0.1:8787/api/ai/scheme-proposals

# Comma-separated origins allowed to call the AI backend.
CURSORDANCE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional simple shared token for the AI backend. Leave empty for local development.
CURSORDANCE_AI_API_ACCESS_TOKEN=
VITE_CURSORDANCE_AI_API_ACCESS_TOKEN=

# Comma-separated exact remote origins for the packaged extension manifest.
# Example: https://api.example.com/*
CURSORDANCE_EXTENSION_HOST_PERMISSIONS=

# Cost and abuse controls.
CURSORDANCE_AI_MAX_REQUEST_BYTES=51200
CURSORDANCE_AI_MAX_PROMPT_CHARS=1200
CURSORDANCE_AI_MAX_CURRENT_CONFIG_BYTES=24576
CURSORDANCE_AI_MAX_PROPOSAL_CONTEXT_BYTES=8192
CURSORDANCE_AI_MAX_OUTPUT_TOKENS=900

# Privacy-safe metrics logs. Set to 0 to disable request metric logs.
CURSORDANCE_AI_METRICS_LOG=1
