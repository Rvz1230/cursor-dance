# DeepSeek API Key（必填）
CURSORDANCE_AI_API_KEY=sk-your-deepseek-api-key

# 访问鉴权 Token（必填，与前端 .env.production 中 VITE_CURSORDANCE_AI_API_ACCESS_TOKEN 一致）
CURSORDANCE_AI_API_ACCESS_TOKEN=your-random-access-token

# 以下为默认值，通常无需修改
CURSORDANCE_AI_API_BASE_URL=https://api.deepseek.com/v1
CURSORDANCE_AI_API_MODE=chat_completions
CURSORDANCE_AI_MODEL=deepseek-chat
CURSORDANCE_ALLOWED_ORIGINS=*
CURSORDANCE_AI_API_PORT=8787
CURSORDANCE_AI_API_HOST=0.0.0.0
CURSORDANCE_AI_METRICS_LOG=1
