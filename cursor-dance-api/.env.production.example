# DeepSeek API Key（必填）
CURSORDANCE_AI_API_KEY=sk-your-deepseek-api-key

# 访问鉴权 Token（必填，与前端 .env.production 中 VITE_CURSORDANCE_AI_API_ACCESS_TOKEN 一致）
CURSORDANCE_AI_API_ACCESS_TOKEN=your-random-access-token

# 以下为默认值，通常无需修改
CURSORDANCE_AI_API_BASE_URL=https://api.deepseek.com/v1
CURSORDANCE_AI_API_MODE=chat_completions
CURSORDANCE_AI_MODEL=deepseek-v4-flash
CURSORDANCE_ALLOWED_ORIGINS=*
CURSORDANCE_AI_API_PORT=8787
CURSORDANCE_AI_API_HOST=0.0.0.0
CURSORDANCE_AI_METRICS_LOG=1

# === 限流配置（可选，不设置则使用默认值）===
# CURSORDANCE_AI_RATE_LIMIT_ENABLED=1           # 总开关，0=关闭
# CURSORDANCE_AI_MAX_CONCURRENCY=3              # 最大并发 AI 请求
# CURSORDANCE_AI_MAX_CONCURRENCY_AGENT=1        # Agent 模式最大并发
# CURSORDANCE_AI_RPM_IP=3                       # 每 IP 每分钟请求数（quick 模式）
# CURSORDANCE_AI_RPH_IP=20                      # 每 IP 每小时请求数（quick 模式）
# CURSORDANCE_AI_RPM_IP_AGENT=1                 # 每 IP 每分钟请求数（agent 模式）
# CURSORDANCE_AI_RPH_IP_AGENT=5                 # 每 IP 每小时请求数（agent 模式）
# CURSORDANCE_AI_DAILY_REQUEST_BUDGET=1000      # 日请求硬上限（0=不限制）
# CURSORDANCE_AI_BUDGET_FILE=/tmp/cd-budget.json # 日预算持久化路径
