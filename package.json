{
  "name": "cursor-dance",
  "private": true,
  "version": "0.6.0",
  "description": "Customizable mouse interaction effects for the desktop and the web.",
  "author": {
    "name": "CursorDance",
    "email": "support@cursordance.app"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rvz1230/cursor-dance"
  },
  "bugs": {
    "url": "https://github.com/Rvz1230/cursor-dance/issues"
  },
  "homepage": "https://github.com/Rvz1230/cursor-dance#readme",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "cursor-dance-api",
    "landing"
  ],
  "scripts": {
    "dev": "vite",
    "ai:dev": "node cursor-dance-api/scripts/dev-server.mjs",
    "ai:check": "node cursor-dance-api/scripts/check-api.mjs",
    "build": "vite build",
    "extension:prepare-manifest": "node scripts/prepare-extension-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:smoke": "playwright test",
    "test:smoke:attached": "CURSORDANCE_SMOKE_EXTERNAL_SERVER=1 playwright test",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "start:electron": "electron-vite preview",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "package:mac:x64": "electron-vite build && electron-builder --mac --x64",
    "package:win": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "clsx": "^2.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^10.16.4",
    "get-windows": "^9.3.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^5.4.21",
    "vitest": "^4.1.6"
  }
}
