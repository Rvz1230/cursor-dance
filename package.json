{
  "name": "cursor-dance",
  "private": true,
  "version": "0.6.1",
  "description": "Customizable mouse interaction effects for the desktop and the web.",
  "author": {
    "name": "CursorDance",
    "email": "support@cursordance.app"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rvz1230/cursor-dance"
  },
  "bugs": {
    "url": "https://github.com/Rvz1230/cursor-dance/issues"
  },
  "homepage": "https://github.com/Rvz1230/cursor-dance#readme",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "cursor-dance-api",
    "landing"
  ],
  "scripts": {
    "dev": "vite",
    "ai:dev": "node cursor-dance-api/scripts/dev-server.mjs",
    "ai:check": "node cursor-dance-api/scripts/check-api.mjs",
    "build": "vite build && npm run build:extension-runtime && npm run verify:extension-build",
    "build:extension-runtime": "vite build --config vite.extension.config.js",
    "verify:extension-build": "node scripts/verify-extension-build.mjs",
    "check:dead-code": "knip",
    "check:conventions": "node scripts/check-code-conventions.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:ui-spec": "node scripts/check-ui-spec.mjs",
    "check:desktop-bundle": "node scripts/check-desktop-bundle-budget.mjs",
    "check:extension-bundle": "node scripts/check-extension-bundle-budget.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --project tsconfig.strict.json && tsc --noEmit --project tsconfig.app-strict.json",
    "extension:prepare-manifest": "node scripts/prepare-extension-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:smoke": "playwright test",
    "test:smoke:attached": "CURSORDANCE_SMOKE_EXTERNAL_SERVER=1 playwright test",
    "test:extension": "npm run build && playwright test --config=playwright.extension.config.js",
    "test:desktop": "playwright test --config=playwright.desktop.config.js",
    "measure:desktop-baseline": "npm run build:electron && node scripts/measure-desktop-baseline.mjs",
    "measure:desktop-baseline:static": "npm run build:electron && node scripts/measure-desktop-baseline.mjs --static-only",
    "build:native:cursor-helper": "node scripts/build-cursor-helper.mjs",
    "test:native:cursor-helper": "node scripts/verify-cursor-helper.mjs",
    "dev:electron": "npm run build:native:cursor-helper && electron-vite dev",
    "build:electron": "npm run build:native:cursor-helper && electron-vite build",
    "start:electron": "electron-vite preview",
    "package:mac": "node scripts/build-cursor-helper.mjs --arch=arm64 --arch=x64 && electron-vite build && electron-builder --mac",
    "package:mac:arm64": "node scripts/build-cursor-helper.mjs --arch=arm64 && electron-vite build && electron-builder --mac --arm64",
    "package:mac:x64": "node scripts/build-cursor-helper.mjs --arch=x64 && electron-vite build && electron-builder --mac --x64",
    "package:win": "npm run build:electron && electron-builder --win",
    "package:dir": "npm run build:electron && electron-builder --dir",
    "package:ci": "node scripts/package-desktop-ci.mjs",
    "verify:package": "node scripts/verify-packaged-desktop.mjs",
    "test:package": "node scripts/smoke-packaged-desktop.mjs",
    "release:verify-tag": "node scripts/release-artifacts.mjs verify-tag",
    "release:verify-commit": "node scripts/release-artifacts.mjs verify-commit",
    "release:verify-signing": "node scripts/release-artifacts.mjs verify-signing",
    "release:checksums": "node scripts/release-artifacts.mjs checksums"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "clsx": "^2.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^10.16.4",
    "get-windows": "^9.3.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.6"
  }
}
