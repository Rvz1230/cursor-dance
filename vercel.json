{
  "builds": [
    {
      "src": "api/ai/scheme-proposals.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai/scheme-proposals-stream.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
